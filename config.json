{
  "app": {
    "number_of_threads": 1,
    "document_root": "/tmp/drogon-openai-example",
    "upload_path": "uploads",
    "log": {
      "log_path": "",
      "logfile_base_name": "",
      "log_size_limit": 100000000,
      "log_level": "DEBUG"
    }
  },
  "listeners": [
    {
      "address": "127.0.0.1",
      "port": 18081
    }
  ],
  "plugins": [
    {
      "name": "drogon_openai::OpenAIClient",
      "config": {
        "base_url": "http://127.0.0.1:18081/v1",
        "api_key_env": "DROGON_OPENAI_TEST_API_KEY",
        "model": "fake-model",
        "max_retries": 2,
        "timeout": {
          "connect": 5,
          "read": 600,
          "write": 600
        },
        "default_headers": {},
        "default_query": {},
        "organization": "",
        "project": ""
      }
    }
  ]
}
